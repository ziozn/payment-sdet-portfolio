<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:text="@string/payment_title"
            android:textColor="#17233B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_amount_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amount_rules"
            android:textColor="#59677F"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_payment_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/amount_hint"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:padding="14dp"
            android:selectAllOnFocus="true" />

        <Button
            android:id="@+id/btn_submit_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="52dp"
            android:text="@string/submit_payment"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_result_title"
                android:textColor="#17233B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_payment_amount_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/payment_amount_not_available"
                android:textColor="#34415A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_payment_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/payment_not_started"
                android:textColor="#34415A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_transaction_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/transaction_id_not_created"
                android:textColor="#59677F"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/back_home"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
